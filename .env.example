POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SQL_MAX_ROWS=200

# OpenAI API key — required for GPT-4o-mini benchmark
OPENAI_API_KEY=sk-your-openai-key-here

# LLM keys — only read from this local .env file (never deployed).
# Groq is the main backend (free at console.groq.com)
GROQ_API_KEY=
# Anthropic Claude Opus 5.5 (console.anthropic.com)
ANTHROPIC_API_KEY=
